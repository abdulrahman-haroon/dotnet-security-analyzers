<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lightbulb fixes. Kept apart from the analyzers because the compiler doesn't allow analyzers
       to reference Microsoft.CodeAnalysis.Workspaces (it only exists inside IDEs). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetSecurityAnalyzers\DotnetSecurityAnalyzers.csproj" />
  </ItemGroup>

</Project>
